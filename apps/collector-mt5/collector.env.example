# Скопировать в collector.env рядом с этим файлом и заполнить.
# collector.env в репозиторий не коммитится (.gitignore).
# Значения секретов вводит принципал; COLLECTOR_TOKEN совпадает с тем, что в .env api.

API_URL=http://localhost:8000
COLLECTOR_TOKEN=
COLLECTOR_ID=nikita-laptop
MT5_TERMINAL_EXE=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PORTABLE_ROOT=C:\td-terminals
SYNC_INTERVAL_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=60
FIRST_SYNC_DAYS=3650
# Сколько счетов коллектор ведёт одновременно: один счёт — один терминал, 300–400 МБ
# памяти. Счёт сверх лимита не молчит: он уходит в «требует внимания» с текстом про
# MAX_ACCOUNTS, и увидеть это можно на его карточке. Счетов больше трёх (первому
# пользователю нужно четыре) — увеличьте значение и перезапустите коллектор.
MAX_ACCOUNTS=3
LOG_LEVEL=INFO

# Необязательное, сверх SPEC.md 8.1. Под Task Scheduler (S1-10) рабочей папкой процесса
# легко оказывается системный каталог, куда писать нельзя. Путь относительный — от рабочей
# папки, в которой запущен коллектор.
LOG_DIR=logs
