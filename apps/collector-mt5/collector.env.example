# Скопировать в collector.env рядом с этим файлом и заполнить.
# collector.env в репозиторий не коммитится (.gitignore).
# Значения секретов вводит принципал; COLLECTOR_TOKEN совпадает с тем, что в .env api.
#
# Путей к терминалу здесь нет намеренно. Коллектор его не запускает и копий не делает:
# MetaTrader 5 открывает человек и входит в счёт сам, а коллектор подключается к тому
# терминалу, который открыт, и синхронизирует именно тот счёт (SPEC.md 8.2).

API_URL=http://localhost:8000
COLLECTOR_TOKEN=
COLLECTOR_ID=nikita-laptop
# Как часто спрашивать терминал о сделках и как часто отмечаться у TradeDesk. Цикл у
# коллектора один и идёт по меньшему из двух: heartbeat уходит каждый тик, а терминал
# спрашивается не чаще, чем велит SYNC_INTERVAL_SECONDS. Молчание дольше пяти минут
# уводит счёт в «коллектор не на связи», поэтому heartbeat реже 300 ставить нельзя.
SYNC_INTERVAL_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=60
FIRST_SYNC_DAYS=3650
LOG_LEVEL=INFO

# Необязательные, сверх SPEC.md 8.1. Под Task Scheduler (S1-10) рабочей папкой процесса
# легко оказывается системный каталог, куда писать нельзя. Пути относительные — от рабочей
# папки, в которой запущен коллектор, то есть от папки установки коллектора.
LOG_DIR=logs
# Единственное, что коллектор помнит между запусками, — смещение часов сервера брокера,
# по файлу на счёт. Папку можно удалить: коллектор пересчитает смещение по котировке.
STATE_DIR=state
