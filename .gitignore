# --- секреты и локальное окружение ---
# .env, .env.local, .env.production, collector.env, collector.env.production —
# в репозиторий попадают только *.env.example. Дублируется хуком forbid-env-files.
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
backups/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# --- Node / web ---
node_modules/
apps/web/dist/
apps/web/.vite/
*.tsbuildinfo

# --- рабочие директории ассистентов ---
.claude/worktrees/
.claude/settings.local.json

# --- ОС и редакторы ---
.DS_Store
.idea/
.vscode/
