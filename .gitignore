# --- секреты и локальное окружение ---
# .env, .env.local, .env.production, collector.env, collector.env.production —
# в репозиторий попадают только *.env.example. Дублируется хуком forbid-env-files.
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
backups/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Логи коллектора на машине пользователя: файл на счёт, внутри — тикеты и суммы
# сделок (SPEC.md 8.2). Создаётся папка запуском run-collector.bat, не тестами.
apps/collector-mt5/logs/

# Просьба менеджеру остановиться: файл живёт секунды, кладёт его stop-collector.bat.
# Пережить он может только жёсткую остановку — и тогда неотслеживаемым файлом
# заблокировал бы сборку релиза (infra/scripts/make-release.sh).
apps/collector-mt5/collector-stop.flag

# --- Node / web ---
node_modules/
apps/web/dist/
apps/web/.vite/
*.tsbuildinfo

# --- рабочие директории ассистентов ---
.claude/worktrees/
.claude/settings.local.json

# Выгрузки с настоящих счетов: в репозиторий не кладутся ни при каких обстоятельствах.
# Обезличенные срезы для тестов живут в apps/api/tests/fixtures/ (docs/fixtures.md).
tmp/

# --- ОС и редакторы ---
.DS_Store
.idea/
.vscode/
