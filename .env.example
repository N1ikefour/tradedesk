# Скопировать в .env через `make init` — он сгенерирует секреты вместо плейсхолдеров.
# Реальные значения секретов вводит принципал. В репозиторий они не попадают никогда.

APP_ENV=local                 # local | prod
APP_NAME=TradeDesk
APP_URL=http://localhost:5173

# --- секреты (генерируются `make init`) ---
# Комментарии здесь отдельными строками, а не после значения: разные читатели .env
# (docker compose, pydantic-settings, sh) обрезают хвост после `#` по-разному, и секрет
# с приклеенным комментарием ломается молча — пароль просто «не подходит».
# сессии, подпись
SECRET_KEY=
# base64 32 байта, шифрование credentials. ПОСЛЕ backfill НЕ МЕНЯТЬ
MASTER_KEY=
OTP_PEPPER=
# сервисный токен коллектора
COLLECTOR_TOKEN=

# Только на время ротации MASTER_KEY: сюда кладётся ПРЕДЫДУЩИЙ ключ, чтобы API читал строки,
# до которых apps/api/scripts/rotate_master_key.py ещё не дошёл. Убрать после «осталось: 0».
# В обычной жизни переменная пустая. Потеря MASTER_KEY необратима — credentials не вернуть.
MASTER_KEY_PREVIOUS=

# --- хранилища ---
# Хосты `postgres` и `redis` — имена сервисов внутри docker-compose. Пароль postgres
# генерирует `make init` и подставляет и сюда, и в POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://td:td@postgres:5432/td
REDIS_URL=redis://redis:6379/0
# Тот же пароль, что внутри DATABASE_URL; его читает контейнер postgres.
POSTGRES_PASSWORD=

# --- сеть ---
# Прокси, чьему X-Forwarded-For можно верить (X-06). ТОЛЬКО точные адреса через запятую.
# Значения по умолчанию — статические адреса web (профиль local) и caddy (профиль prod)
# из docker-compose.yml. Тем же значением запускается uvicorn: `--forwarded-allow-ips`.
#
# ⚠️ Подсети (`10.87.0.0/24`) и `*` приложение отвергает при старте, и это не придирка.
# Подсеть окружения включает шлюз docker — адрес, с которого приходит любой запрос
# с хоста МИМО прокси. Прогон с подсетью в списке: 12 подделанных адресов прямо с хоста
# получили 12 отдельных лимитов, то есть лимита не стало вовсе.
#
# Пусто — заголовок не читается, лимит считается по адресу соединения. За прокси это
# один адрес на всех пользователей; приложение предупреждает об этом в логе при старте.
TRUSTED_PROXIES=10.87.0.10,10.87.0.11

# Домен для профиля prod: caddy берёт под него автосертификат. В local не используется.
DOMAIN=tradedesk.example.com

# Порты на хосте. Значения по умолчанию — 5173, 8000, 5432, 6379, всё на 127.0.0.1.
# Раскомментируйте, если порт занят другой программой; APP_URL тогда тоже поправьте.
#WEB_PORT=5173
#API_PORT=8000
#POSTGRES_PORT=5432
#REDIS_PORT=6379

# --- почта ---
EMAIL_PROVIDER=console        # console | resend
RESEND_API_KEY=
EMAIL_FROM=TradeDesk <no-reply@example.com>

# --- S3 (вложения, S2-04) ---
# Сервиса minio в docker-compose.yml нет до появления потребителя: лишний контейнер на
# 200+ МБ в установке у тестировщика — лишняя точка отказа (docs/tickets/S0-06.md).
S3_ENDPOINT=http://minio:9000
S3_BUCKET=td
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- наблюдаемость ---
SENTRY_DSN=
